{
  "$schema": "../MaaFramework/tools/interface.schema.json",
  "interface_version": 2,
  "languages": {
    "zh_cn": "interface_zh.json",
    "en_us": "interface_en.json"
  },
  "name": "MaaBD2",
  "label": "$project_name",
  "title": "$project_title",
  "version": "0.1.0",
  "description": "$project_description",
  "welcome": "$welcome",
  "license": "MIT",
  "controller": [
    {
      "name": "Windows",
      "label": "$controller_windows",
      "description": "$controller_windows_description",
      "type": "Win32",
      "display_long_side": 1280,
      "win32": {
        "class_regex": "^UnityWndClass$",
        "window_regex": "^BrownDust II$",
        "screencap": "Foreground",
        "mouse": "PostMessageWithCursorPos",
        "keyboard": "PostMessageWithCursorPos"
      }
    }
  ],
  "resource": [
    {
      "name": "CN",
      "label": "$resource_cn",
      "description": "$resource_cn_description",
      "path": [
        "resource"
      ],
      "controller": [
        "Windows"
      ]
    }
  ],
  "task": [
    {
      "name": "连接并回到主界面",
      "label": "$task_startup",
      "entry": "Startup",
      "default_check": true,
      "description": "$task_startup_description"
    },
    {
      "name": "领取奖励",
      "label": "$task_rewards",
      "entry": "ClaimRewards",
      "default_check": true,
      "description": "$task_rewards_description"
    },
    {
      "name": "每日任务",
      "label": "$task_daily",
      "entry": "DailyRoutine",
      "default_check": false,
      "description": "$task_daily_description"
    },
    {
      "name": "每周吸收召集",
      "label": "$task_weekly_absorb_rally",
      "entry": "WeeklyAbsorbRally",
      "default_check": false,
      "description": "$task_weekly_absorb_rally_description",
      "option": [
        "weekly_cassette_route"
      ]
    },
    {
      "name": "自动刷粉",
      "label": "$task_powder",
      "entry": "PowderFarm",
      "default_check": false,
      "description": "$task_powder_description",
      "option": [
        "powder_equipment",
        "powder_count"
      ]
    },
    {
      "name": "自动爬塔",
      "label": "$task_tower",
      "entry": "TowerClimb",
      "default_check": false,
      "description": "$task_tower_description"
    },
    {
      "name": "固定副本",
      "label": "$task_combat",
      "entry": "FixedStageFarming",
      "default_check": false,
      "description": "$task_combat_description",
      "option": [
        "战斗次数"
      ]
    }
  ],
  "option": {
    "战斗次数": {
      "type": "select",
      "label": "$option_combat_count",
      "description": "$option_combat_count_description",
      "default_case": "1",
      "cases": [
        {
          "name": "1",
          "label": "$combat_count_1",
          "pipeline_override": {
            "SetCombatCount": {
              "expected": "1"
            }
          }
        },
        {
          "name": "3",
          "label": "$combat_count_3",
          "pipeline_override": {
            "SetCombatCount": {
              "expected": "3"
            }
          }
        },
        {
          "name": "AllEnergy",
          "label": "$combat_count_all_energy",
          "pipeline_override": {
            "FarmUntilEnergyEmpty": {
              "enabled": true
            }
          }
        }
      ]
    },
    "weekly_cassette_route": {
      "type": "select",
      "label": "$option_weekly_cassette_route",
      "description": "$option_weekly_cassette_route_description",
      "default_case": "default",
      "cases": [
        {
          "name": "default",
          "label": "$weekly_route_default"
        },
        {
          "name": "only_07",
          "label": "$weekly_route_only_07",
          "pipeline_override": {
            "Weekly_RouteStart": {
              "next": "Weekly_RunCassette07"
            },
            "Weekly_ClickMagicCircleBattle2_07": {
              "next": "Weekly_Stop"
            }
          }
        },
        {
          "name": "only_08",
          "label": "$weekly_route_only_08",
          "pipeline_override": {
            "Weekly_RouteStart": {
              "next": "Weekly_RunCassette08"
            },
            "Weekly_ClickMagicCircleBattle2_08": {
              "next": "Weekly_Stop"
            }
          }
        },
        {
          "name": "only_09",
          "label": "$weekly_route_only_09",
          "pipeline_override": {
            "Weekly_RouteStart": {
              "next": "Weekly_RunCassette09"
            },
            "Weekly_ClickMagicCircleBattle2_09": {
              "next": "Weekly_Stop"
            }
          }
        },
        {
          "name": "only_13",
          "label": "$weekly_route_only_13",
          "pipeline_override": {
            "Weekly_RouteStart": {
              "next": "Weekly_RunCassette13"
            },
            "Weekly_ClickMagicCircleBattle2_13": {
              "next": "Weekly_Stop"
            }
          }
        },
        {
          "name": "only_16",
          "label": "$weekly_route_only_16",
          "pipeline_override": {
            "Weekly_RouteStart": {
              "next": "Weekly_RunCassette16"
            },
            "Weekly_ClickMagicCircleBattle2_16": {
              "next": "Weekly_Stop"
            }
          }
        },
        {
          "name": "only_17",
          "label": "$weekly_route_only_17",
          "pipeline_override": {
            "Weekly_RouteStart": {
              "next": "Weekly_RunCassette17"
            },
            "Weekly_ClickMagicCircleBattle2_17": {
              "next": "Weekly_Stop"
            }
          }
        }
      ]
    },
    "powder_equipment": {
      "type": "select",
      "label": "$option_powder_equipment",
      "description": "$option_powder_equipment_description",
      "default_case": "sword",
      "cases": [
        {
          "name": "sword",
          "label": "$powder_equipment_sword"
        },
        {
          "name": "ring",
          "label": "$powder_equipment_ring",
          "pipeline_override": {
            "Powder_ScrollToMercenarySword": {
              "next": "Powder_SelectMercenaryRing"
            }
          }
        }
      ]
    },
