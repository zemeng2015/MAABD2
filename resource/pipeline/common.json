    "action": "Command",
    "exec": "wscript.exe",
    "args": [
      "//B",
      "//Nologo",
      "{RESOURCE_DIR}/tools/bd2_input_hidden.vbs",
      "-Mode",
      "key",
      "-KeyCode",
      "72"
