{
  "NormalizeWindow": {
    "action": "Command",
    "exec": "wscript.exe",
    "args": [
      "//B",
      "//Nologo",
      "{RESOURCE_DIR}/tools/bd2_input_hidden.vbs",
      "-Mode",
      "resize",
      "-TargetWidth",
      "1280",
      "-TargetHeight",
      "720"
    ],
    "post_delay": 800
  },
  "EnsureHome": {
    "next": [
      "ResolveHome"
    ]
  },
  "WaitForHome": {
    "next": [
      "ResolveHome"
    ]
  },
