  "Flag_Home_RightTop": {
    "recognition": "TemplateMatch",
    "template": "home/home_marker.png"
  },
  "Flag_Home_LeftHouse720p": {
    "recognition": "TemplateMatch",
    "template": "home/home_house_720p.png",
    "roi": [
      60,
      55,
      120,
      120
    ],
    "threshold": 0.72
  },
  "Flag_Home_TaskEntry720p": {
    "recognition": "TemplateMatch",
    "template": "home/task_entry_720p.png",
    "roi": [
      390,
      590,
      130,
      120
    ],
    "threshold": 0.72
  },
  "Flag_Home_ActivityEntry720p": {
    "recognition": "TemplateMatch",
    "template": "home/activity_entry_720p.png",
    "roi": [
      540,
      590,
      120,
      120
    ],
    "threshold": 0.72
  },
  "Flag_Home_MailEntry": {
    "recognition": "TemplateMatch",
    "template": "reward/mail_entry.png"
  },
  "Flag_Home_TaskEntry": {
    "recognition": "TemplateMatch",
    "template": "reward/task_entry.png"
  },
  "Click_TouchToStart": {
    "recognition": "TemplateMatch",
    "template": "startup/touch_to_start.png",
    "roi": [
      700,
      380,
      460,
      170
